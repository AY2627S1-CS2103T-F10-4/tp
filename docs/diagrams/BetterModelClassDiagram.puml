@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

class "UniquePersonList<Jobseeker>" as Jobseekers
class "UniquePersonList<Client>" as Clients
class "{abstract}\nPerson" as Person

AddressBook *-right-> "1" UniqueTagList
AddressBook *--> "1" Jobseekers
AddressBook *--> "1" Clients

UniqueTagList -right-> "*" Tag
Jobseekers --> "*" Jobseeker
Clients --> "*" Client

Jobseeker --|> Person
Client --|> Person

Person -up-> "*" Tag
@enduml
