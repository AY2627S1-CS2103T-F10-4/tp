@startuml
!include style.puml
skinparam ClassFontColor #000000
skinparam ClassBorderColor #000000
skinparam ClassBackgroundColor #FFFFAA
skinparam roundCorner 0

title After command "undo"

class State1 as "<u>ab0:AddressBook</u>"
class State2 as "<u>ab1:AddressBook</u>"
class State3 as "<u>ab2:AddressBook</u>"

State1 -[hidden]right-> State2
State2 -[hidden]right-> State3

'The pointer is an int field rather than an object, so a UML note marks the state it points to.
'PlantUML draws a note with only one link as a wedge, so a hidden link to Spacer keeps the connector dashed.
class Spacer <<unused>>
hide <<unused>>
note "currentStatePointer" as Pointer
State2 .. Pointer
Pointer -[hidden]right- Spacer
@enduml
