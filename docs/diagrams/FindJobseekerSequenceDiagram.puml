@startuml
!include style.puml
skinparam ArrowFontStyle plain
'The DG scales images down to its page width, so a larger font alone only widens the image.
'Labels are wrapped to keep the diagram narrow, which is what makes the text bigger on the page.
skinparam defaultFontSize 18

box Logic LOGIC_COLOR_T1
participant ":Logic\nManager" as LogicManager LOGIC_COLOR
participant ":AddressBook\nParser" as AddressBookParser LOGIC_COLOR
participant ":FindJobseeker\nCommandParser" as Parser LOGIC_COLOR
participant "c:FindJobseeker\nCommand" as Command LOGIC_COLOR
participant "r:Command\nResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
participant "p:PersonContains\nKeywordsPredicate" as Predicate MODEL_COLOR
end box

[-> LogicManager : execute(\n"findj bob")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand(\n"findj bob")
activate AddressBookParser

create Parser
AddressBookParser -> Parser
activate Parser

Parser --> AddressBookParser
deactivate Parser

AddressBookParser -> Parser : parse(" bob")
activate Parser

create Predicate
Parser -> Predicate : PersonContainsKeywordsPredicate(["bob"])
activate Predicate

Predicate --> Parser : p
deactivate Predicate

create Command
Parser -> Command : FindJobseeker\nCommand(p)
activate Command

Command --> Parser : c
deactivate Command

Parser --> AddressBookParser : c
deactivate Parser
'Hidden arrow to position the destroy marker below the end of the activation bar.
Parser -[hidden]-> AddressBookParser
destroy Parser

AddressBookParser --> LogicManager : c
deactivate AddressBookParser

LogicManager -> Command : execute(m)
activate Command

Command -> Model : updateFiltered\nJobseekerList(...)
activate Model

loop more unhidden\njobseekers
    Model -> Predicate : test(jobseeker)
    activate Predicate

    Predicate --> Model : isMatch
    deactivate Predicate
end

Model --> Command
deactivate Model

Command -> Model : getFiltered\nJobseekerList()
activate Model

Model --> Command : matches
deactivate Model

create CommandResult
Command -> CommandResult : CommandResult(\n"n jobseeker(s)\nlisted!")
activate CommandResult

CommandResult --> Command : r
deactivate CommandResult

Command --> LogicManager : r
deactivate Command

[<-- LogicManager : r
deactivate LogicManager
@enduml
