@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":FindJobseeker\nCommandParser" as Parser LOGIC_COLOR
participant "c:FindJobseeker\nCommand" as Command LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
participant "p:PersonContains\nKeywordsPredicate" as Predicate MODEL_COLOR
end box

[-> LogicManager : execute("findj alice bob")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("findj alice bob")
activate AddressBookParser

create Parser
AddressBookParser -> Parser
activate Parser

Parser --> AddressBookParser
deactivate Parser

AddressBookParser -> Parser : parse(" alice bob")
activate Parser

create Predicate
Parser -> Predicate : PersonContainsKeywordsPredicate(["alice", "bob"])
activate Predicate

Predicate --> Parser : p
deactivate Predicate

create Command
Parser -> Command : FindJobseekerCommand(p)
activate Command

Command --> Parser : c
deactivate Command

Parser --> AddressBookParser : c
deactivate Parser
'Hidden arrow to position the destroy marker below the end of the activation bar.
Parser -[hidden]-> AddressBookParser
destroy Parser

AddressBookParser --> LogicManager : c
deactivate AddressBookParser

LogicManager -> Command : execute(m)
activate Command

Command -> Model : updateFilteredJobseekerList(...)
activate Model

loop more unhidden jobseekers
    Model -> Predicate : test(jobseeker)
    activate Predicate

    Predicate --> Model : isMatch
    deactivate Predicate
end

Model --> Command
deactivate Model

Command -> Model : getFilteredJobseekerList()
activate Model

Model --> Command : matches
deactivate Model

create CommandResult
Command -> CommandResult : CommandResult("n jobseeker(s) listed!")
activate CommandResult

CommandResult --> Command : r
deactivate CommandResult

Command --> LogicManager : r
deactivate Command

[<-- LogicManager : r
deactivate LogicManager
@enduml
