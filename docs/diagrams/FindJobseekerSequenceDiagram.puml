@startuml
!include style.puml
skinparam ArrowFontStyle plain
'LogicManager, AddressBookParser and CommandResult are omitted because the DG's Logic component section shows them.
'The DG scales images down to its page width, so keep this diagram narrow rather than raising the font size.
skinparam defaultFontSize 16

box Logic LOGIC_COLOR_T1
participant ":FindJobseeker\nCommandParser" as Parser LOGIC_COLOR
participant "c:FindJobseeker\nCommand" as Command LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
participant "p:PersonContains\nKeywordsPredicate" as Predicate MODEL_COLOR
end box

[-> Parser : parse(" bob")
activate Parser

create Predicate
Parser -> Predicate : PersonContainsKeywordsPredicate(["bob"])
activate Predicate

Predicate --> Parser : p
deactivate Predicate

create Command
Parser -> Command : FindJobseeker\nCommand(p)
activate Command

Command --> Parser : c
deactivate Command

[<-- Parser : c
deactivate Parser
'Hidden arrow to position the destroy marker below the end of the activation bar.
Parser -[hidden]-> Command
destroy Parser

[-> Command : execute(m)
activate Command

Command -> Model : updateFilteredJobseekerList(...)
activate Model

loop more unhidden jobseekers
    Model -> Predicate : test(jobseeker)
    activate Predicate

    Predicate --> Model : isMatch
    deactivate Predicate
end

Model --> Command
deactivate Model

Command -> Model : getFilteredJobseekerList()
activate Model

Model --> Command : matches
deactivate Model

[<-- Command
deactivate Command
'Hidden arrow to position the destroy marker below the end of the activation bar.
Command -[hidden]-> Model
destroy Command
@enduml
