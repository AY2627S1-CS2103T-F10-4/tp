@startuml
!include style.puml
skinparam ClassFontColor #000000
skinparam ClassBorderColor #000000
skinparam ClassBackgroundColor #FFFFAA

title Initial state

package States {
    class State1 as "<u>ab0:AddressBook</u>"
    class State2 as "<u>ab1:AddressBook</u>" <<unused>>
    class State3 as "<u>ab2:AddressBook</u>" <<unused>>
}

State1 -[hidden]right-> State2
State2 -[hidden]right-> State3

'Hidden by stereotype, as newer PlantUML versions ignore hiding a class by name.
hide <<unused>>

'The pointer is an int field rather than an object, so a UML note marks the state it points to.
note bottom of State1 : currentStatePointer
@enduml
