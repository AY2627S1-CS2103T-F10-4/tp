@startuml
!include style.puml
skinparam ArrowFontStyle plain

box UI UI_COLOR_T1
participant ":MainWindow" as MainWindow UI_COLOR
participant ":System Clipboard" as Clipboard UI_COLOR
end box

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":CopyClientCommandParser" as CopyClientCommandParser LOGIC_COLOR
participant "c:CopyClientCommand" as CopyClientCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

box Storage STORAGE_COLOR_T1
participant ":Storage" as Storage STORAGE_COLOR
end box

[-> MainWindow : executeCommand("cpc 1")
activate MainWindow UI_COLOR

MainWindow -[UI_COLOR]> LogicManager : execute("cpc 1")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("cpc 1")
activate AddressBookParser

create CopyClientCommandParser
AddressBookParser -> CopyClientCommandParser
activate CopyClientCommandParser

CopyClientCommandParser --> AddressBookParser
deactivate CopyClientCommandParser

AddressBookParser -> CopyClientCommandParser : parse("1")
activate CopyClientCommandParser

create CopyClientCommand
CopyClientCommandParser -> CopyClientCommand
activate CopyClientCommand

CopyClientCommand --> CopyClientCommandParser : c
deactivate CopyClientCommand

CopyClientCommandParser --> AddressBookParser : c
deactivate CopyClientCommandParser
' Hidden arrow to position the destroy marker below the end of the activation bar.
CopyClientCommandParser -[hidden]-> AddressBookParser
destroy CopyClientCommandParser

AddressBookParser --> LogicManager : c
deactivate AddressBookParser

LogicManager -> CopyClientCommand : execute(m)
activate CopyClientCommand

CopyClientCommand -> Model : getFilteredClientList()
activate Model

Model --> CopyClientCommand : displayedClients
deactivate Model

CopyClientCommand -> CopyClientCommand : get client at index 1
CopyClientCommand -> CopyClientCommand : Messages.format(client)

create CommandResult
CopyClientCommand -> CommandResult : feedback, clipboard text
activate CommandResult

CommandResult --> CopyClientCommand : r
deactivate CommandResult

CopyClientCommand --> LogicManager : r
deactivate CopyClientCommand

LogicManager -> Model : getAddressBook()
activate Model

Model --> LogicManager : addressBook
deactivate Model

LogicManager -> Storage : saveAddressBook(addressBook)
activate Storage

Storage --> LogicManager
deactivate Storage

LogicManager -[LOGIC_COLOR]> MainWindow : r
deactivate LogicManager

MainWindow -> CommandResult : getClipboardText()
activate CommandResult

CommandResult --> MainWindow : clipboardText
deactivate CommandResult

MainWindow -[UI_COLOR]> Clipboard : setContent(clipboardText)
activate Clipboard UI_COLOR

Clipboard --> MainWindow
deactivate Clipboard

[<--MainWindow
deactivate MainWindow
@enduml
