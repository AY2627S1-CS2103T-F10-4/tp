@startuml
skin rose
skinparam ActivityFontSize 15
skinparam ArrowFontSize 12
start
:User executes command;
:LogicManager parses and
executes command;

'Since the beta syntax does not support placing the condition outside the
'diamond we place it as the true branch instead.

if () then ([parsing or
execution failed])
else ([else])
    :Save address book
    through Storage;
    if () then ([save failed])
        :Restore previous data
        and pointer position;
    else ([else])
        if () then ([differs from
current state])
            :Purge states after
            currentStatePointer;
            :Save data to
            addressBookStateList;
        else ([else])
        endif
    endif
endif
stop
@enduml
