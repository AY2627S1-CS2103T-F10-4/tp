@startuml
!include style.puml
!pragma layout smetana
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR
hide empty members

package Model as ModelPackage <<Rectangle>> {
class "<<interface>>\nModel" as Model
class "<<interface>>\nReadOnlyAddressBook" as ReadOnlyAddressBook
class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
class ModelManager
class AddressBook
class UserPrefs
class "UniquePersonList<Jobseeker>" as Jobseekers
class "UniquePersonList<Client>" as Clients
abstract class Person
class Jobseeker
class Client
class Name
class Phone
class Email
class Address
class Remark
class Tag
class Qualification
class Job
}

ModelManager ..|> Model
AddressBook ..|> ReadOnlyAddressBook
UserPrefs ..|> ReadOnlyUserPrefs
Model ..> ReadOnlyAddressBook
Model ..> ReadOnlyUserPrefs
ModelManager --> "1" AddressBook
ModelManager --> "1" UserPrefs
AddressBook *--> "1" Jobseekers : jobseekers
AddressBook *--> "1" Clients : clients
Jobseekers --> "*" Jobseeker
Clients --> "*" Client
Jobseeker --|> Person
Client --|> Person
ModelManager --> "*" Jobseeker : filteredJobseekers
ModelManager --> "*" Client : filteredClients
Person --> "1" Name
Person --> "1" Phone
Person --> "1" Email
Person --> "1" Address
Person --> "1" Remark
Person --> "*" Tag
Jobseeker --> "1" Qualification : highestQualification
Client --> "*" Job : availableJobs

@enduml
