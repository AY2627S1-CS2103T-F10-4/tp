@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam defaultFontSize 14

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as Logic LOGIC_COLOR
participant "command:\nTagJobseekerCommand" as Command LOGIC_COLOR
end box
box Model MODEL_COLOR_T1
participant "model:Model" as Model MODEL_COLOR
participant "replacement:Jobseeker" as Replacement MODEL_COLOR
end box

[-> Logic : execute("tagj 1 java")
activate Logic
Logic -> Command : execute(model)
activate Command
Command -> Model : getFilteredJobseekerList()
activate Model
Model --> Command : displayedJobseekers
deactivate Model
Command -> Command : getTarget(displayedJobseekers, ...)
activate Command
Command --> Command : target
deactivate Command
Command -> Command : getUpdatedTags(target)
activate Command
ref over Command : Shared tag update (next diagram)
Command --> Command : updatedTags
deactivate Command
'A single return after the frame, so the activation bar ends where the method returns.
opt updatedTags.isPresent()
    create Replacement
    Command -> Replacement : <<create>> Jobseeker(...,\nupdatedTags.get(), ...)
    Command -> Model : setJobseeker(target, replacement)
    activate Model
    Model --> Command
    deactivate Model
end
Command --> Logic : no-change or success result
deactivate Command
[<-- Logic
deactivate Logic
@enduml
